  shorttitle = {{{SPUR}}},
  author = {Sakshi, S. and Lokegaonkar, Vaibhavi and Zhang, Neil and Duraiswami, Ramani and Ghosh, Sreyan and Manocha, Dinesh and Lu, Lie},
